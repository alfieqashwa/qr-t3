// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    // NOTE: When using postgresql, mysql or sqlserver, uncomment the @db.Text annotations in model Account below
    // Further reading:
    // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
    // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
    url      = env("DATABASE_URL")
}

// Necessary for Next auth
model Account {
    id                String  @id @default(cuid())
    userId            String  @map("user_id")
    type              String
    provider          String
    providerAccountId String  @map("provider_account_id")
    refresh_token     String? @db.Text
    access_token      String? @db.Text
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String? @db.Text
    session_state     String?
    user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique @map("session_token")
    userId       String   @map("user_id")
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id               String          @id @default(cuid())
    name             String?
    email            String?         @unique
    emailVerified    DateTime?       @map("email_verified")
    image            String?
    accounts         Account[]
    sessions         Session[]
    eventOrganizer   EventOrganizer? @relation(fields: [eventOrganizerId], references: [id])
    eventOrganizerId String?         @map("event_organizer_id")
    role             Role            @default(ADMIN)
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

model Address {
    id             String           @id @default(cuid())
    street         String
    city           String
    postalCode     String           @map("postal_code")
    EventOrganizer EventOrganizer[]
}

model EventOrganizer {
    id        String  @id @default(cuid())
    name      String  @unique()
    phone     String?
    address   Address @relation(fields: [addressId], references: [id])
    addressId String  @map("address_id")
    // EventOrg many2one -> User 
    users     User[]
    // EventOrg many2one -> Event 
    events    Event[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("event_organizer")
}

model Event {
    id               String          @id @default(cuid())
    title            String          @unique()
    date             DateTime
    location         String
    EventOrganizer   EventOrganizer? @relation(fields: [eventOrganizerId], references: [id])
    eventOrganizerId String?         @map("event_organizer_id")
    // Event many2one -> Visitor
    visitors         Visitor[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")
}

model Visitor {
    id          String    @id @default(cuid())
    name        String
    isCheckIn   Boolean   @default(false) @map("is_check_in")
    checkInDate DateTime? @map("check_in_date")
    Event       Event?    @relation(fields: [eventId], references: [id])
    eventId     String?   @map("event_id")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")
}

enum Role {
    DEWA // -> Full Access.
    ADMIN // -> CRUD Only its Event/Events && Member/Members && Invite Editor.
    EDITOR // -> CRUD Only its Member/Members.
    OPERATOR // -> Read Only its Event/Events and Only get Access to Scanner Page.
    MEMBER // -> next feature: default Role when user register on web [strict Authorization].
}
