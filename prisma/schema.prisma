// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  // NOTE: When using postgresql, mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// Necessary for Next auth
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id               String          @id @default(cuid())
  name             String?
  email            String          @unique
  emailVerified    DateTime?       @map("email_verified")
  image            String?
  imageUpdate      String?
  accounts         Account[]
  sessions         Session[]
  eventOrganizer   EventOrganizer? @relation(fields: [eventOrganizerId], references: [id], onDelete: Cascade)
  eventOrganizerId String?         @map("event_organizer_id")
  role             Role            @default(USER)

  @@index([eventOrganizerId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EventOrganizer {
  id         String   @id @default(cuid())
  name       String   @unique()
  phone      String
  province   String
  regency    String
  district   String
  village    String
  street     String
  postalCode String   @map("postal_code")
  // EventOrg many2one -> User 
  users      User[]
  // EventOrg many2one -> Event 
  events     Event[]
  tickets    Ticket[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("event_organizer")
}

model Event {
  id               String         @id @default(cuid())
  title            String         @unique()
  thumbnail        String?
  date             DateTime
  venue            String
  profit           Boolean        @default(true)
  eventOrganizer   EventOrganizer @relation(fields: [eventOrganizerId], references: [id], onDelete: Cascade)
  eventOrganizerId String         @map("event_organizer_id")
  // Event m2o -> Ticket
  tickets          Ticket[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([eventOrganizerId])
  @@map("events")
}

model Ticket {
  id           String @id @default(cuid())
  ticketNumber Int?   @map("ticket_number")
  category     String
  price        Float?
  status       Status @default(AVAILABLE)

  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String? @map("event_id")

  eventOrganizer   EventOrganizer? @relation(fields: [eventOrganizerId], references: [id], onDelete: Cascade)
  eventOrganizerId String          @map("event_organizer_id")

  visitor Visitor?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([eventOrganizerId])
  @@index([eventId])
  @@map("tickets")
}

model Visitor {
  id           String    @id @default(cuid())
  name         String
  phone        String
  email        String?   @unique
  isCheckIn    Boolean   @default(false) @map("is_check_in")
  checkInDate  DateTime? @map("check_in_date")
  checkOutDate DateTime? @map("check_out_date")

  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String @unique @map("ticket_id") // relation scalar field (used in the `@relation` attribute above)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([ticketId])
  @@map("visitors")
}

enum Role {
  DEWA // -> Full Access.
  ADMIN // -> CRUD Only its Event/Events && Invite Editor.
  EDITOR // -> CRUD Only its Event/Events && Operator.
  OPERATOR // -> Read Only its Event/Events and Only get Access to Scanner Page.
  USER // -> Default Role
}

enum Status {
  AVAILABLE
  BOOKED
  PURCHASED
  REFUND
}
